# HydroSynth Unified Environment Configuration
# Copy this file to .env and adjust paths for your local machine/server.

# 1. External Data Workspace (for auto-isolated cache/, results/, checkpoints/)
HYDRO_WORKSPACE=E:/Hydro_Workspace

# 2. Shared Raw Datasets Root Directory
HYDRO_DATA_DIR=E:/DATA

# 3. Compute Device (Optional: cuda:0, mps, cpu)
HYDRO_DEVICE=cuda:0
